# ============================================
# Vaayura MVP Environment Variables
# ============================================
# Copy this file to .env and fill in your actual values
# DO NOT commit .env to version control

# ============================================
# RAZORPAY PAYMENT GATEWAY
# ============================================
# Get your keys from: https://dashboard.razorpay.com/app/keys

# Test Mode (for development)
VITE_RAZORPAY_KEY_ID=rzp_test_YOUR_TEST_KEY_HERE

# Live Mode (for production - uncomment when ready)
# VITE_RAZORPAY_KEY_ID=rzp_live_YOUR_LIVE_KEY_HERE

# ============================================
# BACKEND API URL
# ============================================
# Development (local Vercel dev server)
VITE_BACKEND_URL=http://localhost:3000

# Production (your deployed Vercel backend URL)
# VITE_BACKEND_URL=https://your-backend.vercel.app

# ============================================
# SUPABASE DATABASE
# ============================================
# Get these from: https://app.supabase.com/project/_/settings/api

VITE_SUPABASE_URL=https://YOUR_PROJECT_ID.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_ANON_KEY_HERE

# ============================================
# NOTES
# ============================================
# 1. VITE_RAZORPAY_KEY_ID: Only the KEY_ID (public) goes here
#    - The KEY_SECRET (private) stays in backend/.env
#
# 2. VITE_BACKEND_URL: This tells frontend where to find your APIs
#    - Development: http://localhost:3000 (Vercel dev)
#    - Production: Your deployed Vercel URL
#
# 3. All variables starting with VITE_ are exposed to the browser
#    - Never put secrets/private keys in VITE_ variables
#
# 4. For production deployment:
#    - Set these in your hosting provider's environment variables
#    - Vercel: Project Settings → Environment Variables
#    - Netlify: Site Settings → Build & Deploy → Environment
